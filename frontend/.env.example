# CodeSage frontend — environment configuration.
#
# This is the ONLY client-exposed variable in this app. It is a public
# base URL, never a secret — the FastAPI backend's own credentials
# (Groq API key, Postgres/Redis/Qdrant connection strings) live in
# backend/.env and are NEVER read by, or exposed through, this frontend.
#
# Local development (matches docker-compose.yml's backend port):
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production (Vercel): set this to your deployed FastAPI backend's public
# origin, e.g. https://api.your-domain.com — and make sure that backend's
# CORS_ORIGINS env var includes your Vercel deployment's origin
# (https://your-app.vercel.app), or every request from this frontend will
# be rejected by the browser's CORS policy. See
# docs/SPRINT_7_IMPLEMENTATION_SPEC.md section 34 for exact steps.
