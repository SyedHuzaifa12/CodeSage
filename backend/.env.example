# For running the backend directly on the host (uvicorn app.main:app --reload),
# NOT inside Docker — hosts point at localhost since the Docker service
# names (postgres/redis/qdrant) only resolve on the compose network.
# If the docker-compose stack is running, its ports are published to
# localhost, so this works against it too.

# ===== Application =====
APP_NAME=CodeSage
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage

# ===== Hosted database (Neon etc.) =====
# Hosted: paste the provider's connection string AS IS. It wins over the POSTGRES_* fields above. A Neon string with
# `sslmode=require&channel_binding=require` and a `-pooler` host works unmodified (the app maps the TLS setting,
# drops the parameter asyncpg rejects, and turns prepared-statement caching off for pooled endpoints).
DATABASE_URL=
# Optional: a DIRECT (non-pooled) URL used only by `alembic upgrade head`. Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Discrete mode only: require/verify-full/disable. (A URL carries its own ?sslmode=.)
POSTGRES_SSLMODE=
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Upstash and most hosted Redis are TLS-only: set REDIS_SSL=true (certificate and hostname are verified).
REDIS_SSL=false
REDIS_SSL_CA_CERTS=

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Qdrant Cloud: the cluster URL (https://<id>.<region>.<provider>.cloud.qdrant.io[:6333]) and an API key replace the
# host/ports above. The key is shown once when created; give it no expiry or it silently stops working in 90 days.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5

# ===== LLM (configuration only — no calls made yet) =====
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
# fastembed = local ONNX model (default, ~300MB RAM); cloudflare = hosted Workers AI
# (ADR-029; same BGE-small weights, 384 dims, free 10k neurons/day, no card needed).
# Switching providers re-embeds each repository on its next index.
EMBEDDING_PROVIDER=fastembed
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pooling must stay "cls" to match the local model (Cloudflare's own default, mean, is not equivalent).
CLOUDFLARE_EMBEDDING_POOLING=cls
CLOUDFLARE_EMBEDDING_BATCH_SIZE=100
# How many files' chunks are pooled into one embed()/Qdrant-upsert call
# during knowledge indexing (pipeline-optimization pass).
KNOWLEDGE_FILE_BATCH_SIZE=25

# ===== Ingestion (noise filtering — pipeline-optimization pass) =====
# Extra, project-specific exclusions beyond the scanner's built-in
# dependency/build/VCS directory, lockfile, and media/binary lists
# (comma-separated; usually left empty).
INGESTION_EXTRA_IGNORED_DIRS=
INGESTION_EXTRA_IGNORED_FILENAMES=
INGESTION_EXTRA_IGNORED_SUFFIXES=
# Respect each cloned repository's own .gitignore as an additional,
# repo-specific noise signal.
INGESTION_RESPECT_GITIGNORE=true
# Files larger than this (bytes) are excluded from the scan entirely.
INGESTION_MAX_FILE_SIZE_BYTES=5000000

# ===== Celery (ADR-026 — indexing moved off FastAPI BackgroundTasks) =====
# Reuses the existing Redis instance as broker/backend, but on its own
# logical DB index (never REDIS_DB above, which is the cache's).
CELERY_REDIS_DB=1
# Caps concurrent indexing jobs across independent repositories; passed
# to `celery worker --concurrency` (see README/compose command), kept
# here too so both run paths default to the same number.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1700
CELERY_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_SECONDS=10
# TTL for the per-repository Redis lock preventing two concurrent
# indexing tasks for the same repository; keep above the time limit above.
INDEXING_LOCK_TTL_SECONDS=2400

# ===== Roles and indexing backend (ADR-028) =====
# ROLE: "all" runs everything in one process (local default). Hosted mode runs two services from the
# same image: ROLE=api (HTTP only, never indexes) and ROLE=indexer (job-claim loop + /internal/wake).
ROLE=all
# celery = ADR-026 behaviour (docker-compose). postgres = the indexing_jobs table is the queue (no broker);
# needs ROLE=all, or ROLE=api + ROLE=indexer as two services.
INDEXING_BACKEND=celery
# ROLE=api + INDEXING_BACKEND=postgres only: where to wake the indexer, and the shared secret both use.
INDEXER_URL=
# (INTERNAL_API_TOKEN is in the auth section above and must be identical on both services.)
# A running job renews its lease every HEARTBEAT seconds; if the lease lapses another worker takes the job over.
INDEXING_LEASE_SECONDS=120
INDEXING_HEARTBEAT_SECONDS=30
INDEXING_MAX_ATTEMPTS=3
INDEXING_RETRY_BACKOFF_SECONDS=10

# ===== Logging =====
LOG_LEVEL=
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=codesage.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
