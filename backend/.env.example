# For running the backend directly on the host (uvicorn app.main:app --reload),
# NOT inside Docker — hosts point at localhost since the Docker service
# names (postgres/redis/qdrant) only resolve on the compose network.
# If the docker-compose stack is running, its ports are published to
# localhost, so this works against it too.

# ===== Application =====
APP_NAME=CodeSage
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== LLM (configuration only — no calls made yet) =====
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
# How many files' chunks are pooled into one embed()/Qdrant-upsert call
# during knowledge indexing (pipeline-optimization pass).
KNOWLEDGE_FILE_BATCH_SIZE=25

# ===== Ingestion (noise filtering — pipeline-optimization pass) =====
# Extra, project-specific exclusions beyond the scanner's built-in
# dependency/build/VCS directory, lockfile, and media/binary lists
# (comma-separated; usually left empty).
INGESTION_EXTRA_IGNORED_DIRS=
INGESTION_EXTRA_IGNORED_FILENAMES=
INGESTION_EXTRA_IGNORED_SUFFIXES=
# Respect each cloned repository's own .gitignore as an additional,
# repo-specific noise signal.
INGESTION_RESPECT_GITIGNORE=true
# Files larger than this (bytes) are excluded from the scan entirely.
INGESTION_MAX_FILE_SIZE_BYTES=5000000

# ===== Celery (ADR-026 — indexing moved off FastAPI BackgroundTasks) =====
# Reuses the existing Redis instance as broker/backend, but on its own
# logical DB index (never REDIS_DB above, which is the cache's).
CELERY_REDIS_DB=1
# Caps concurrent indexing jobs across independent repositories; passed
# to `celery worker --concurrency` (see README/compose command), kept
# here too so both run paths default to the same number.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1700
CELERY_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_SECONDS=10
# TTL for the per-repository Redis lock preventing two concurrent
# indexing tasks for the same repository; keep above the time limit above.
INDEXING_LOCK_TTL_SECONDS=2400

# ===== Logging =====
LOG_LEVEL=
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=codesage.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
