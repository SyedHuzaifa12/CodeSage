# For running the backend directly on the host (uvicorn app.main:app --reload),
# NOT inside Docker — hosts point at localhost since the Docker service
# names (postgres/redis/qdrant) only resolve on the compose network.
# If the docker-compose stack is running, its ports are published to
# localhost, so this works against it too.

# ===== Application =====
APP_NAME=CodeSage
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== LLM (configuration only — no calls made yet) =====
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ===== Logging =====
LOG_LEVEL=
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=codesage.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
