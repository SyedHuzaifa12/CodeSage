# syntax=docker/dockerfile:1

# Hosted image (Render free tier), ADR-028/ADR-030. One image runs both services; the ROLE
# environment variable decides which: ROLE=api (HTTP only) or ROLE=indexer (job worker).
#
# Differences from the local Dockerfile, all deliberate:
#  - no local ML stack (fastembed / onnxruntime, ~50 MB RSS and ~300 MB more while embedding):
#    hosted embeddings come from Cloudflare Workers AI (EMBEDDING_PROVIDER=cloudflare);
#  - dependencies are pinned (constraints-hosted.txt), so a surprise upstream release cannot
#    break a deploy build;
#  - no test tooling, and it listens on $PORT (Render sets it; default 10000).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=10000

WORKDIR /app

# git is required at runtime by GitPython (it shells out to the real git binary).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-base.txt constraints-hosted.txt ./
RUN pip install -r requirements-base.txt -c constraints-hosted.txt

COPY . .

# Clones live on the (ephemeral) container disk: they are scratch space for one indexing job.
RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /app/data/repositories \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 10000

# exec: uvicorn becomes PID 1 and receives SIGTERM on deploys, so the indexer can hand its job back.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
