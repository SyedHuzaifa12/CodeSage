# Copy this file to .env before running `docker compose up`.
# These are local-development-only defaults — safe to keep as-is for a
# local/demo run, but never reuse them outside a local environment.

# ===== Application =====
APP_NAME=CodeSage
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# ===== Backend =====
BACKEND_PORT=8000

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage
# Host-side published port for `docker compose` (localhost:<this> from
# outside Docker). Only change this if 5432 is already taken on your
# machine by something else — never change POSTGRES_PORT above for that,
# it's the internal Docker-network port and must stay 5432.
POSTGRES_HOST_PORT=5432

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Host-side published port — same rule as POSTGRES_HOST_PORT above.
REDIS_HOST_PORT=6379

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== LLM (Groq primary, Ollama fallback — ADR-014) =====
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TEMPERATURE=0.15
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1.0
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_TTL_SECONDS=2592000
EMBEDDING_MODEL_CACHE_DIR=data/embedding_cache
# How many files' chunks are pooled into one embed()/Qdrant-upsert call
# during knowledge indexing (pipeline-optimization pass).
KNOWLEDGE_FILE_BATCH_SIZE=25

# ===== Ingestion (noise filtering — pipeline-optimization pass) =====
# Extra, project-specific exclusions beyond the scanner's built-in
# dependency/build/VCS directory, lockfile, and media/binary lists
# (comma-separated; usually left empty).
INGESTION_EXTRA_IGNORED_DIRS=
INGESTION_EXTRA_IGNORED_FILENAMES=
INGESTION_EXTRA_IGNORED_SUFFIXES=
# Respect each cloned repository's own .gitignore as an additional,
# repo-specific noise signal.
INGESTION_RESPECT_GITIGNORE=true
# Files larger than this (bytes) are excluded from the scan entirely.
INGESTION_MAX_FILE_SIZE_BYTES=5000000

# ===== Celery (ADR-026 — indexing moved off FastAPI BackgroundTasks) =====
# Reuses the existing Redis instance as broker/backend, but on its own
# logical DB index (never REDIS_DB above, which is the cache's).
CELERY_REDIS_DB=1
# Caps concurrent indexing jobs across independent repositories; passed
# to `celery worker --concurrency` (see docker-compose.yml's
# celery-worker service), kept here too so both run paths default to
# the same number.
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT_SECONDS=1800
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1700
CELERY_MAX_RETRIES=2
CELERY_RETRY_BACKOFF_SECONDS=10
# TTL for the per-repository Redis lock preventing two concurrent
# indexing tasks for the same repository; keep above the time limit above.
INDEXING_LOCK_TTL_SECONDS=2400

# ===== AI Engine (Sprint 5) =====
MAX_EVIDENCE_ITEMS=8
MAX_EVIDENCE_PER_FILE=2
MAX_CONTEXT_CHARS=12000
MAX_VERIFICATION_RETRIES=1
MIN_EVIDENCE_RELEVANCE=0.15
TOTAL_TIMEOUT_SECONDS=45.0
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=1800

# ===== Logging =====
LOG_LEVEL=
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=codesage.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
