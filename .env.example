# Copy this file to .env before running `docker compose up`.
# These are local-development-only defaults — safe to keep as-is for a
# local/demo run, but never reuse them outside a local environment.

# ===== Application =====
APP_NAME=CodeSage
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=*

# ===== Backend =====
BACKEND_PORT=8000

# ===== PostgreSQL =====
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codesage
POSTGRES_PASSWORD=codesage
POSTGRES_DB=codesage

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===== Qdrant =====
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ===== LLM (configuration only — no calls made yet) =====
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_TTL_SECONDS=2592000
EMBEDDING_MODEL_CACHE_DIR=data/embedding_cache

# ===== Logging =====
LOG_LEVEL=
LOG_FORMAT=json
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE_NAME=codesage.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
